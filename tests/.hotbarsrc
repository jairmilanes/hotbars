{
  "env": "test",
  "styleMode": "scss",
  "logLevel": 0,
  "source": "tests/__data__",
  "jsonSchema": "schema",
  "jsonDb": "db/db.json",
  "auth": {
    "enabled": true
  },
  "language": {
    "enabled": true,
    "languages": ["en", "pt-br"],
    "options": [
      {
        "name": "English",
        "code": "en",
        "currency": {
          "sign": "$",
          "code": "USD"
        }
      },
      {
        "name": "Portuguese (Brazil)",
        "code": "pt-br",
        "currency": {
          "sign": "R$",
          "code": "BRL"
        }
      }
    ],
    "defaultOption": {
      "name": "English",
      "code": "en",
      "currency": {
        "sign": "$",
        "code": "USD"
      }
    }
  }
}

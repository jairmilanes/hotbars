{{#extend "_default" title="Data"}}
  {{#content "main"}}
    <section class="container mx-auto grow flex flex-col relative overflow-hidden">
      {{#embed "_card" layout="grid" title="" padding=0 class="overflow-hidden grow"}}
        {{#content "content"}}
          {{{embed "_col" cols=4 partial="_pages/data/collections" class="bg-gray-200 dark:bg-gray-800"}}}
          {{{embed "_col" cols=4 partial="_pages/data/items" class="border-l border-gray-200 dark:border-gray-700"}}}
          {{{embed "_col" cols=4 partial="_pages/data/item-view" class="border-l border-gray-200 dark:border-gray-700"}}}
          {{{embed "_col" cols=4 partial="_pages/data/item-editor" class="hidden border-l border-gray-200 dark:border-gray-700"}}}
        {{/content}}
      {{/embed}}
    </section>
  {{/content}}
  {{#content "styles"}}
    {{styles (append
               "https://cdn.jsdelivr.net/npm/quill@2.0.0-rc.2/dist/quill.snow.css, "
               (replace "/public/libs/prism-{THEME}.css" "{THEME}" settings.theme)
     )}}
  {{/content}}
  {{#content "scripts"}}
    {{scripts "https://cdn.jsdelivr.net/npm/quill@2.0.0-rc.2/dist/quill.js,
               https://cdn.jsdelivr.net/npm/ace-builds@1.12.5/src-noconflict/ace[.min].js,
               /public/libs/prism.js,
               /app/data.js"}}
    <script>
      $(() => $("#collection-form").form({}))
    </script>
  {{/content}}
{{/extend}}
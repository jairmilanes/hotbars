{{#extend "_default" title="Data Types" paddingX=0 paddingY=0}}
  {{#content "styles"}}
    {{styles (append
       "/public/libs/quill.dark.css, "
       (replace "/public/libs/prism-{THEME}.css" "{THEME}" settings.theme)
     )}}
  {{/content}}
  {{#content "pageHeader"}}
    {{{embed "_modules/_page-header" title=title description=description paddingX=8}}}
  {{/content}}
  {{#content "main"}}
    <section class="container mx-auto grow flex flex-col relative overflow-hidden">
      {{#embed "_card" layout="grid" title="" padding=0 rounded=false class="overflow-hidden grow"}}
        {{clear "rounded"}}
        {{#content "content"}}
          {{{embed "_col" cols=3 partial="_pages/data-types/types" class="overflow-hidden"}}}
          {{{embed "_col" cols=9 partial="_pages/data-types/content" class="border-l border-base-light dark:border-base-dark overflow-hidden"}}}
        {{/content}}
      {{/embed}}
    </section>
  {{/content}}
  {{#content "scripts"}}
    {{scripts "https://cdn.jsdelivr.net/npm/quill@2.0.0-rc.2/dist/quill.js,
               https://cdn.jsdelivr.net/npm/chart.js,
               /public/libs/prism.js"}}
    <script>
      // $(() => $("#type-form").form({}))
    </script>
  {{/content}}
{{/extend}}
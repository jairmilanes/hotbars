{{#extend "_default" title="Config"}}
  {{#content "main"}}
    <section class="container flex flex-col mx-auto w-full relative grow overflow-hidden">
      {{#embed "_card" title="" overflow="y" size="full" padding="md" bodyClass="grow"}}
        {{#content "body"}}
          <pre style="margin: 0; overflow: visible;">
            <code class="language-json line-numbers block p-0 m-0 h-full w-full break-words whitespace-pre">
              {{{JSONstringify config 4}}}
            </code>
          </pre>
        {{/content}}
      {{/embed}}
    </section>
  {{/content}}
  {{#content "styles"}}
    {{styles (replace "/public/libs/prism-{THEME}.css" "{THEME}" settings.theme)}}
  {{/content}}
  {{#content "scripts"}}
    {{scripts "/public/libs/prism.js"}}
  {{/content}}
{{/extend}}
{{#block "_data-type-item"}}
  <div id="dismiss-{{name}}" class="flex gap-2 w-full pl-4 pr-1 py-2 border-b border-gray-700 last:border-b-0">
    <div class="w-[60%]">{{name}}</div>
    <div class="w-[40%]">{{type}}</div>
    {{{embed "_button" type="button" icon="close" style="link" size="link" class="remove"}}}
  </div>
{{/block}}
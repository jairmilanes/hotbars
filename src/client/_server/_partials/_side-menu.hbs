<div id="hb-side-panel" class="{{#if settings.sidePanel}}open{{/if}} flex flex-col group shrink-0 border-r border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900">
  <div class="grow flex flex-col w-[4rem] group-[.open]:w-60">
    <div class="px-4 mb-8 sm:px-4 py-3 border-b border-gray-300 dark:border-gray-700">
      <a href="/" class="flex items-center group-[.open]:mr-8">
        <img
          src="https://flowbite.com/docs/images/logo.svg"
          class="h-6 w-auto mr-3 sm:h-9"
          alt="Flowbite Logo"
        />
        <span
          class="hidden group-[.open]:flex self-center text-xl font-semibold whitespace-nowrap text-gray-900 dark:text-white/[.85]"
        >Hotbars</span>
      </a>
    </div>
    <ul class="grow flex flex-col space-y-2 md:p-0 md:mt-0  md:text-sm md:font-medium">
      {{#each (i "_hbs.menu")}}
        {{#eq data.id "hb-user-menu-container"}}
          <li  class="placeholder border-t border-gray-700">
            <ul id="{{data.id}}" {{#forIn data}} data-{{@key}}="{{this}}"{{/forIn}}>
              {{#each ../typeMenu}}
                {{{embed "_sidemenu-item" id=(concat ../data.id "-" @index)}}}
              {{/each}}
            </ul>
          </li>
        {{else}}
          {{{embed "_sidemenu-item"}}}
        {{/eq}}
      {{/each}}
    </ul>
    <div class="flex justify-center group-[.open]:justify-end px-2 py-3 border-t border-gray-200 dark:border-gray-700">
      {{{embed "_button" id="hb-close-side-panel" style="link" color="gray" size="icon4xl" icon="first_page" class="hidden group-[.open]:block"}}}
      {{{embed "_button" id="hb-open-side-panel" style="link" color="gray" size="icon4xl" icon="last_page" class="block group-[.open]:hidden"}}}
    </div>
  </div>
</div>
